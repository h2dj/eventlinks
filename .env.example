# Turso 데이터베이스 접속 정보
# https://turso.tech 에서 데이터베이스를 만든 뒤 `turso db show <db-name>` / `turso db tokens create <db-name>` 로 확인
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# 관리자 로그인 비밀번호 (원하는 값으로 직접 지정)
ADMIN_PASSWORD=change-me

# 로그인 세션 쿠키 서명에 사용하는 비밀 키 (아래 명령으로 생성한 랜덤 값 사용 권장)
# openssl rand -hex 32
AUTH_SECRET=change-me-too

# 참고: 로컬 개발 시 TURSO_DATABASE_URL을 설정하지 않으면
# 프로젝트 폴더에 자동 생성되는 local.db 파일(SQLite)을 대신 사용합니다.
